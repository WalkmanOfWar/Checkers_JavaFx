<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.Cursor?>

<Group xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1">
    <cursor><Cursor fx:constant="OPEN_HAND"/></cursor>

    <!-- Drop shadow -->
    <Ellipse centerX="52" centerY="66" radiusX="30" radiusY="10" fill="#00000055"/>

    <!-- Main body -->
    <Ellipse centerX="50" centerY="50" radiusX="36" radiusY="29">
        <fill>
            <RadialGradient centerX="0.32" centerY="0.28" radius="0.85" proportional="true">
                <stops>
                    <Stop offset="0.0"  color="#ff7070"/>
                    <Stop offset="0.45" color="#cc1a00"/>
                    <Stop offset="1.0"  color="#6a0000"/>
                </stops>
            </RadialGradient>
        </fill>
    </Ellipse>

    <!-- Outer rim -->
    <Ellipse centerX="50" centerY="50" radiusX="36" radiusY="29"
             fill="transparent" stroke="#8b1500" strokeWidth="2"/>

    <!-- Inner ring -->
    <Ellipse centerX="50" centerY="50" radiusX="26" radiusY="20"
             fill="transparent" stroke="#ff443060" strokeWidth="1.2"/>

    <!-- Specular highlight -->
    <Ellipse centerX="38" centerY="38" radiusX="13" radiusY="8"
             fill="#ffffff45" rotate="-25"/>
</Group>
